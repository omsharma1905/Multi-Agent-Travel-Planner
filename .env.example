# ==============================================================================
# SAFARIX — Environment Variables Specification
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, Railway, Fly.io), set these in your deployment dashboard.
# NEVER commit .env.local or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION (Client & Server)
# ------------------------------------------------------------------------------
# Public application base URL (e.g. http://localhost:3000 or https://safarix.travel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public application display name
NEXT_PUBLIC_APP_NAME="SafariX"

# Deployment environment ("development" | "production" | "test")
# NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE & PERSISTENCE (PostgreSQL + Drizzle ORM)
# ------------------------------------------------------------------------------
# MANDATORY IN PRODUCTION (Server-only). Connection string to PostgreSQL instance.
# Supports connection pooling (Supabase, Neon, AWS RDS, Railway, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safarix

# Optional: Direct connection URL for migrations when using PgBouncer / connection pooler
DIRECT_URL=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY (HMAC Signed Sessions)
# ------------------------------------------------------------------------------
# MANDATORY IN PRODUCTION (Server-only). Minimum 32-character high-entropy secret.
# Generate via: openssl rand -base64 32
SESSION_SECRET=

# Optional alias for backward compatibility with NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. AI ORCHESTRATION & PLANNING ENGINE (Google Gemini)
# ------------------------------------------------------------------------------
# MANDATORY IN PRODUCTION (Server-only). Gemini API key from Google AI Studio or GCP.
# Used by AgentCoordinator, DestinationAgent, ItineraryAgent, BudgetAgent, SafetyAgent.
GOOGLE_GENERATIVE_AI_API_KEY=

# ------------------------------------------------------------------------------
# 5. TRAVEL DATA PROVIDERS & ENFORCEMENT
# ------------------------------------------------------------------------------
# Travel provider mode: "real" | "mock"
# In development, defaults to "mock" for offline capability.
# In production, "real" is strictly enforced by zero-mock runtime guards.
TRAVEL_DATA_MODE=mock

# --- Google Places & Dining APIs (New Places API) ---
# MANDATORY IN PRODUCTION for live attractions and dining (Server-only).
GOOGLE_PLACES_API_KEY=
# Optional fallback alias if sharing key with Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# --- Duffel API (Flights & Accommodations / Stays) ---
# MANDATORY IN PRODUCTION for live flight offer search and lodging search (Server-only).
# Replaces decommissioned Amadeus Self-Service APIs.
# Register at: https://duffel.com
# Test tokens start with "duffel_test_" | Production tokens start with "duffel_live_"
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com

# --- Routing & Geo Services ---
# Routing & Directions base URL (defaults to public demo server).
# For production workloads, deploy a dedicated OSRM instance.
OSRM_BASE_URL=https://router.project-osrm.org
# Note: Geocoding uses Open-Meteo REST API (https://geocoding-api.open-meteo.com/v1) which requires no API key.

# --- Verified Photography (Optional) ---
# Optional (Server-only). Pexels API key (https://www.pexels.com/api/).
# If omitted or unconfigured, SafariX gracefully renders thematic destination gradients.
PEXELS_API_KEY=

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# MANDATORY IN PRODUCTION (Server-only). Protects auth, AI generation, and travel APIs.
# In development, gracefully falls back to in-memory sliding window rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 7. INTERNAL SECURITY & DIAGNOSTIC ENDPOINTS
# ------------------------------------------------------------------------------
# MANDATORY IN PRODUCTION to authorize internal health & diagnostic routes (/api/internal/*).
# In production, any request lacking "x-internal-secret: <INTERNAL_API_SECRET>" returns 404.
INTERNAL_API_SECRET=

# ------------------------------------------------------------------------------
# 8. ANALYTICS & MONITORING (Optional)
# ------------------------------------------------------------------------------
# Optional client-side analytics ID
NEXT_PUBLIC_ANALYTICS_ID=